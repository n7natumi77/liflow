# Browser-visible Firebase Web Push public key (not a secret).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# The following are Cloudflare Worker secrets/variables. Never commit values.
FIREBASE_SERVICE_ACCOUNT_JSON=
DISCORD_PUBLIC_KEY=
DISCORD_TRUSTED_CHANNEL_IDS=
DISCORD_ALLOWED_USER_IDS=
LIFLOW_FIREBASE_UID=

# Optional build/runtime metadata.
LIFLOW_BUILD_ID=
APP_ORIGIN=

# Optional legacy /api/entities bindings. Liflow's Firebase UI does not require these.
CLOUDFLARE_D1_BINDING=
CLOUDFLARE_D1_DATABASE_NAME=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BINDING=
CLOUDFLARE_R2_BUCKET_NAME=

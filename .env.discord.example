# Discord Developer Portalで作成したBotのToken
DISCORD_BOT_TOKEN=
# テスト中はGuild IDを指定するとslash commandがすぐ反映されます
DISCORD_GUILD_ID=
# 操作を許可する自分のDiscord User ID。カンマ区切りで複数指定可
DISCORD_ALLOWED_USER_IDS=
# 閲覧・操作を許可するChannel ID。カンマ区切りで複数指定可
DISCORD_TRUSTED_CHANNEL_IDS=
# Firebase Consoleから取得したサービスアカウントJSONの絶対パス
FIREBASE_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json
# Liflow設定画面やFirebase Authenticationで確認できる自分のUID
LIFLOW_FIREBASE_UID=

# 以下はデプロイしたInteraction endpointを使う場合に設定
# Discord Developer PortalのGeneral InformationにあるPublic Key
DISCORD_PUBLIC_KEY=
# FIREBASE_SERVICE_ACCOUNT_FILEの内容を1行JSONとしてSecretへ登録
FIREBASE_SERVICE_ACCOUNT_JSON=
